{
  "name": "creative-default",
  "register_target": "direct, concrete prose with adult rhythm and no generic AI cadence",
  "default_mode": "rewrite",
  "reader_profile": "A working writer using AI as an editor, not as a generic content machine.",
  "scene_anchor": "A local drafting session where the user is comparing original and revised prose.",
  "preserve": ["meaning", "facts", "POV", "speaker intent", "sequence of events"],
  "prefer": ["specific action", "physical objects", "plain verbs", "embodied scene", "varied rhythm"],
  "avoid": ["AI cadence", "fake contrast", "rule-of-three drama", "cinematic fog", "body cliches", "abstract reveal endings"],
  "hard_bans": ["Let that sink in.", "Full stop.", "Here's the thing:"],
  "soft_flags": ["This matters because", "It wasn't", "couldn't help but", "felt a sense of"],
  "filter_words": {
    "enabled": true,
    "ignore_dialogue": true,
    "severity": "taste_flag",
    "custom_severity": "hard_fail",
    "categories": {
      "perception": ["saw", "heard", "felt", "noticed", "watched"],
      "cognitive": ["realized", "knew", "thought", "wondered", "remembered", "decided"],
      "distancing": ["could see", "could hear", "began to", "started to"],
      "hedges": ["just", "really", "quite", "rather", "somewhat", "perhaps"],
      "vague_modifiers": ["very", "somehow", "almost", "slightly", "a little", "a bit"]
    },
    "custom": []
  },
  "possible_adverbs": {"enabled": true, "ignore_dialogue": true, "confirm_pos": false, "exceptions": []},
  "possible_adjectives": {"enabled": false, "ignore_dialogue": false, "exceptions": []},
  "possible_verbs": {"enabled": false, "ignore_dialogue": false, "exceptions": []},
  "cliches": {"ignore_dialogue": true},
  "cliche_categories": {
    "general": true,
    "genre": true,
    "self_help": true,
    "corporate": true,
    "wordiness": true,
    "redundancy": true
  },
  "external_tools": {"proselint": false, "harper": false, "vale": false, "languagetool": false},
  "manuscript": {"use_spacy": false},
  "analyzer_weights": {
    "binary_contrast": 1.2,
    "negative_listing": 1.2,
    "body_cliches": 1.0,
    "cinematic_fog": 1.0,
    "metaphor_density": 0.9,
    "triad_cadence": 0.9,
    "filter_words": 1.0,
    "stylometry": 0.45,
    "cliches": 0.8,
    "external_tools": 0.4
  }
}
